
// esta es la configuración en el servidor esclavo
//
// Do any local configuration here
//

zone "empresa.local" {
  type slave;
  allow-query {any;};
  masters {192.168.50.3;};
  file "/var/cache/bind/db.empresa.slave";
};

zone "50.168.192.in-addr.arpa" {
  type slave;
  allow-query {any;};
  masters {192.168.50.3;};
  file "/var/cache/bind/db.empresa.reverse.slave";
};
