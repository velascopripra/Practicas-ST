//
// Do any local configuration here
//

/*Zona hacia adelante*/
zone "velasco.com" {
    type master;
    file "/etc/bind/db.velasco.com";
};

/*Zona inversa*/
zone "50.168.192.in-addr.arpa" {
  type master;
  file "/etc/bind/db.192.168.50";
  allow-transfer {192.168.50.4;};
  notify yes;
  allow-query{any;};
};


zone "servicios.com" {
    type master;
    file "/etc/bind/db.servicios.com";
};


zone "miotrositio.com" {
    type master;
    file "/etc/bind/db.miotrositio.com";
};

zone "empresa.local" {
type master;
file "/etc/bind/db.empresa.local";
allow-transfer {192.168.50.4;};
notify yes;
allow-query{any;};
};

/*Zona del punto 2 del parcial 1*/
zone "parcial.velasco.com" {
    type master;
    file "/etc/bind/db.parcial.velasco.com";
};

/*Zona para el punto 3 del parcial 1*/
zone "pagina.expuesta.com" {
    type master;
    file "/etc/bind/db.pagina.expuesta.com";
};

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";
